DATABASE_URL="postgresql://outbox:outbox@localhost:5433/outbox?schema=public"

# --- App config ---
PORT=4000
REDIS_URL=redis://localhost:6379

# Worker
WORKER_CONCURRENCY=5
# Minimum gap enforced between any two email sends processed by this worker (ms).
# Mimics real SMTP-provider throttling. BullMQ Worker "limiter" option enforces this queue-wide.
EMAIL_SEND_MIN_DELAY_MS=2000

# Rate limiting default (used when a Sender doesn't specify its own maxEmailsPerHour)
DEFAULT_MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Frontend origin, for CORS
FRONTEND_ORIGIN=http://localhost:3000
